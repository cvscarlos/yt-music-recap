# Copy to .env and fill in. Only enrich.ts reads this; recap.ts needs nothing.
#
# An API key, not an OAuth client — this only reads public video metadata.
#   1. Create a project at https://console.cloud.google.com
#   2. Enable "YouTube Data API v3" under APIs & Services -> Library
#   3. Create the key at https://console.cloud.google.com/apis/credentials?project=<project-id>
YOUTUBE_API_KEY=

# Only export.ts reads these, and only to create a playlist in your account. Reading needs
# a key; writing has to act as you, which needs OAuth. The token it earns is written to
# oauth.env, not here, so nothing this project runs can disturb what you typed.
#   1. Same project -> APIs & Services -> Credentials -> Create credentials
#   2. OAuth client ID, application type "Desktop app"
#   3. On the consent screen, add your own address under Test users
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Two-letter country code for where you watch. Tracks licensed elsewhere are left out of
# the playlist link, since YouTube hides them without saying so. Defaults to your system
# locale's country, which is wrong if you run an English system in another country.
RECAP_REGION=
